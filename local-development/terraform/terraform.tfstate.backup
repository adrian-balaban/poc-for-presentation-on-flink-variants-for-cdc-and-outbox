    {
      "mode": "managed",
      "type": "grafana_rule_group",
      "name": "flink_cdc_poc",
      "provider": "provider[\"registry.terraform.io/grafana/grafana\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "disable_provenance": false,
            "folder_uid": "dfp73vlp296o0a",
            "id": "1:dfp73vlp296o0a:flink-cdc-poc-alerts",
            "interval_seconds": 60,
            "name": "flink-cdc-poc-alerts",
            "org_id": "1",
            "rule": [
              {
                "annotations": {
                  "description": "Job {{$labels.job_name}} restarted more than 3 times in the last 5 minutes.",
                  "summary": "Flink job restart loop detected"
                },
                "condition": "threshold",
                "data": [
                  {
                    "datasource_uid": "prometheus",
                    "model": "{\"expr\":\"increase(flink_jobmanager_job_numRestarts[5m])\",\"legendFormat\":\"{{job_name}}\",\"refId\":\"A\"}",
                    "query_type": "",
                    "ref_id": "A",
                    "relative_time_range": [
                      {
                        "from": 300,
                        "to": 0
                      }
                    ]
                  },
                  {
                    "datasource_uid": "__expr__",
                    "model": "{\"conditions\":[{\"evaluator\":{\"params\":[3],\"type\":\"gt\"},\"operator\":{\"type\":\"and\"},\"query\":{\"params\":[\"A\"]},\"reducer\":{\"params\":[],\"type\":\"last\"},\"type\":\"query\"}],\"expression\":\"A\",\"refId\":\"threshold\",\"type\":\"threshold\"}",
                    "query_type": "",
                    "ref_id": "threshold",
                    "relative_time_range": [
                      {
                        "from": 300,
                        "to": 0
                      }
                    ]
                  }
                ],
                "exec_err_state": "Error",
                "for": "1m0s",
                "is_paused": false,
                "keep_firing_for": "",
                "labels": {
                  "severity": "critical"
                },
                "missing_series_evals_to_resolve": 0,
                "name": "Flink Restart Loop",
                "no_data_state": "OK",
                "notification_settings": [],
                "record": [],
                "uid": "bfp7479y9gxs0c"
              },
              {
                "annotations": {
                  "description": "Job {{$labels.job_name}} last checkpoint duration exceeded 180 s (value: {{$values.A}} ms).",
                  "summary": "Flink checkpoint taking too long"
                },
                "condition": "threshold",
                "data": [
                  {
                    "datasource_uid": "prometheus",
                    "model": "{\"expr\":\"flink_jobmanager_job_lastCheckpointDuration\",\"legendFormat\":\"{{job_name}}\",\"refId\":\"A\"}",
                    "query_type": "",
                    "ref_id": "A",
                    "relative_time_range": [
                      {
                        "from": 300,
                        "to": 0
                      }
                    ]
                  },
                  {
                    "datasource_uid": "__expr__",
                    "model": "{\"conditions\":[{\"evaluator\":{\"params\":[180000],\"type\":\"gt\"},\"operator\":{\"type\":\"and\"},\"query\":{\"params\":[\"A\"]},\"reducer\":{\"params\":[],\"type\":\"last\"},\"type\":\"query\"}],\"expression\":\"A\",\"refId\":\"threshold\",\"type\":\"threshold\"}",
                    "query_type": "",
                    "ref_id": "threshold",
                    "relative_time_range": [
                      {
                        "from": 300,
                        "to": 0
                      }
                    ]
                  }
                ],
                "exec_err_state": "Error",
                "for": "2m0s",
                "is_paused": false,
                "keep_firing_for": "",
                "labels": {
                  "severity": "warning"
                },
                "missing_series_evals_to_resolve": 0,
                "name": "Flink Checkpoint Duration High",
                "no_data_state": "OK",
                "notification_settings": [],
                "record": [],
                "uid": "dfp7479y9gxs1e"
              },
              {
                "annotations": {
                  "description": "Job {{$labels.job_name}} had more than 3 checkpoint failures in the last 5 minutes.",
                  "summary": "Flink checkpoint failures spike"
                },
                "condition": "threshold",
                "data": [
                  {
                    "datasource_uid": "prometheus",
                    "model": "{\"expr\":\"increase(flink_jobmanager_job_numberOfFailedCheckpoints[5m])\",\"legendFormat\":\"{{job_name}}\",\"refId\":\"A\"}",
                    "query_type": "",
                    "ref_id": "A",
                    "relative_time_range": [
                      {
                        "from": 300,
                        "to": 0
                      }
                    ]
                  },
                  {
                    "datasource_uid": "__expr__",
                    "model": "{\"conditions\":[{\"evaluator\":{\"params\":[3],\"type\":\"gt\"},\"operator\":{\"type\":\"and\"},\"query\":{\"params\":[\"A\"]},\"reducer\":{\"params\":[],\"type\":\"last\"},\"type\":\"query\"}],\"expression\":\"A\",\"refId\":\"threshold\",\"type\":\"threshold\"}",
                    "query_type": "",
                    "ref_id": "threshold",
                    "relative_time_range": [
                      {
                        "from": 300,
                        "to": 0
