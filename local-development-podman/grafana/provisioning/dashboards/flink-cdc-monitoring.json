      "title": "Restart Loop — numRestarts (5 min) [threshold >3]",
      "description": "Mirrors Datadog: flink.job.numRestarts change() > 3 per job. Alert = restart loop.",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "increase(flink_jobmanager_job_numRestarts[5m])",
          "legendFormat": "{{job_name}}",
          "refId": "A"
        }
      ],
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
