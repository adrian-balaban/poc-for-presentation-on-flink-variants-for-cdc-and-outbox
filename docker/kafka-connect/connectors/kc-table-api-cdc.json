{
  "name": "kc-table-api-cdc",
  "config": {
    "connector.class": "io.debezium.connector.mysql.MySqlConnector",
    "database.hostname": "localhost",
    "database.port": 3306,
    "database.user": "flink",
    "database.password": "flink",
    "database.server.id": "6000",
    "database.server.name": "mysql-tableapi",
    "database.include.list": "poc_db",
    "table.include.list": "poc_db.orders,poc_db.customers,poc_db.products",
    "snapshot.mode": "initial",
    "transforms": "enrichment",
    "transforms.enrichment.type": "poc.kafka.connect.EnrichmentTransform",
    "transforms.enrichment.variant.name": "table-api-cdc",
    "transforms.enrichment.topic.prefix": "poc.cdc.tableapi",
    "key.converter": "org.apache.kafka.connect.json.JsonConverter",
    "key.converter.schemas.enable": false,
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": false,
    "decimal.handling.mode": "string",
    "include.schema.changes": false,
    "publication.name": "poc_tableapi",
    "topic.prefix": "poc.cdc.tableapi"
  }
}
